# Copy to .env in the directory where you run commands.
# Replace all three placeholders with your own provider's settings.
# CLI loads .env; Python examples explicitly call load_dotenv().
# Existing environment variables take precedence. Never commit credentials.
DARWINAGENT_BASE_URL=https://your-provider.example/v1
DARWINAGENT_MODEL=your-model-name
DARWINAGENT_API_KEY=your-api-key
# Optional provider-specific parameters; disabled by default.
DARWINAGENT_MODEL_PROFILES=false
